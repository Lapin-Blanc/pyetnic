			<xs:import namespace="http://etnic.be/types/technical/requestId/v1" schemaLocation="xsd/requestId_v1.xsd"/>
		</xs:schema>
	</wsdl:types>
	
	<wsdl:message name="RechercherInscriptionsRequeteMessage">
