<wsdl:definitions name="SEPSRechercheInscriptionsServiceExternalV1" targetNamespace="http://ws.etnic.be/seps/rechercheInscriptions/v1" xmlns:msg="http://ws.etnic.be/seps/rechercheInscriptions/messages/v1" xmlns:req="http://etnic.be/types/technical/requestId/v1" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://ws.etnic.be/seps/rechercheInscriptions/v1" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<wsdl:types>
