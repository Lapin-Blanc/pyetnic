<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://ws.etnic.be/seps/enregistrerInscription/messages/v1" version="1.0" xmlns:cfNum="http://enseignement.cfwb.be/types/seps/cfNum/v1" xmlns:ext="http://etnic.be/types/technical/external/v1" xmlns:in="http://enseignement.cfwb.be/types/seps/inscription/v1" xmlns:tns="http://ws.etnic.be/seps/enregistrerInscription/messages/v1" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<xs:import namespace="http://enseignement.cfwb.be/types/seps/cfNum/v1" schemaLocation="cfNum_v1.xsd"/>
	<xs:import namespace="http://enseignement.cfwb.be/types/seps/inscription/v1" schemaLocation="inscription_v1.xsd"/>
