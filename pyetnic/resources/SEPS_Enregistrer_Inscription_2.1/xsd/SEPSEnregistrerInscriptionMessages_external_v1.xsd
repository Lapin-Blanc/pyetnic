		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ModifierInscriptionReponseType">
		<xs:complexContent>
			<xs:extension base="ext:AbstractExternalResponseType">
				<xs:sequence>
					<xs:element minOccurs="0" name="response">
						<xs:complexType>
							<xs:sequence>
