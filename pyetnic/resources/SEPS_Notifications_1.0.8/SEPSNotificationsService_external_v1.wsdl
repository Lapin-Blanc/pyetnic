<wsdl:definitions name="SEPSNotificationsServiceExternalV1" targetNamespace="http://ws.etnic.be/seps/notifications/v1" xmlns:msg="http://ws.etnic.be/seps/notifications/messages/v1" xmlns:req="http://etnic.be/types/technical/requestId/v1" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://ws.etnic.be/seps/notifications/v1" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<wsdl:types>
		<xs:schema>
			<xs:import namespace="http://ws.etnic.be/seps/notifications/messages/v1" schemaLocation="xsd/SEPSNotificationsMessages_external_v1.xsd"/>
			<xs:import namespace="http://etnic.be/types/technical/requestId/v1" schemaLocation="xsd/requestId_v1.xsd"/>
		</xs:schema>
	</wsdl:types>

	<wsdl:message name="LireNotificationsRequeteMessage">
		<wsdl:part element="msg:lireNotifications" name="parameters"/>
	</wsdl:message>
	<wsdl:message name="LireNotificationsReponseMessage">
		<wsdl:part element="msg:lireNotificationsReponse" name="parameters"/>
	</wsdl:message>

	<wsdl:message name="RequestIdHeader">
		<wsdl:part element="req:requestId" name="requestId"/>
	</wsdl:message>

	<wsdl:portType name="SEPSNotificationsV1PortType">
		<wsdl:operation name="lireNotifications">
			<wsdl:input message="tns:LireNotificationsRequeteMessage"/>
			<wsdl:output message="tns:LireNotificationsReponseMessage"/>
		</wsdl:operation>
	</wsdl:portType>

	<wsdl:binding name="SEPSNotificationsV1ExternalBinding" type="tns:SEPSNotificationsV1PortType">
		<soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
		<wsdl:operation name="lireNotifications">
			<wsdl:input>
				<soap:header message="tns:RequestIdHeader" part="requestId" use="literal" wsdl:required="false"/>
				<soap:body use="literal"/>
			</wsdl:input>
			<wsdl:output>
				<soap:header message="tns:RequestIdHeader" part="requestId" use="literal" wsdl:required="true"/>
				<soap:body use="literal"/>
			</wsdl:output>
		</wsdl:operation>
	</wsdl:binding>
	<wsdl:service name="service_seps_notifications_external_v1">
		<wsdl:port binding="tns:SEPSNotificationsV1ExternalBinding" name="SEPSNotificationsV1ExternalPort">
			<soap:address location="https://ws.etnic.be:443/seps/notifications/v1"/>
		</wsdl:port>
	</wsdl:service>
</wsdl:definitions>
